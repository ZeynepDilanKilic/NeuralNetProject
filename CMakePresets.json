{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NEURALNET_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan",
      "inherits": "debug",
      "cacheVariables": { "NEURALNET_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "coverage",
      "displayName": "Debug + coverage",
      "inherits": "debug",
      "cacheVariables": { "NEURALNET_ENABLE_COVERAGE": "ON" }
    },
    {
      "name": "msvc",
      "displayName": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "NEURALNET_WARNINGS_AS_ERRORS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug",    "configurePreset": "debug" },
    { "name": "release",  "configurePreset": "release" },
    { "name": "asan",     "configurePreset": "asan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "msvc",     "configurePreset": "msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug",    "configurePreset": "debug",    "output": { "outputOnFailure": true } },
    { "name": "release",  "configurePreset": "release",  "output": { "outputOnFailure": true } },
    { "name": "asan",     "configurePreset": "asan",     "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } },
    { "name": "msvc",     "configurePreset": "msvc",     "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
